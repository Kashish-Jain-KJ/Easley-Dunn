# ============================================================
# .env.example — copy this file to .env and fill in your values
# NEVER commit the real .env file to version control
# ============================================================

# ── Dev server ───────────────────────────────────────────────
# The port Create React App serves on. Must be in the backend's
# CORS_ORIGINS, or the browser blocks every API call.
PORT=3000

# ── API ──────────────────────────────────────────────────────
# Where the backend is reachable *from the browser*, not from the
# server. Falls back to http://localhost:5001 when unset.
REACT_APP_API_URL=http://localhost:5001

# ── Google OAuth ─────────────────────────────────────────────
# Client ID from the Google Cloud console. Public by design — it
# ships in the JS bundle — but still environment-specific.
# Unset falls back to a dummy id and the Google button will not work.
REACT_APP_GOOGLE_CLIENT_ID=

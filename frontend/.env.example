# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env.
#
# [REQUIRED] the app will not work without it
# [OPTIONAL] has a working default; the value shown IS the default
#
# WARNING: these are baked into the build, NOT read at runtime. Changing them
# on the server does nothing — you must rebuild and redeploy the frontend.
# =============================================================================

# [OPTIONAL] dev server port.
# Must appear in the backend's CORS_ORIGINS or the browser blocks every call.
PORT=3000

# [REQUIRED in production] where the BROWSER reaches the backend.
# Not where the server reaches it.
REACT_APP_API_URL=http://localhost:5001

# [OPTIONAL] Google OAuth client ID. Public by design — it ships inside the JS
# bundle — but different per environment. Unset = a dummy value and the Google
# sign-in button does not work.
REACT_APP_GOOGLE_CLIENT_ID=

# ============================================================
# .env.example — copy this file to .env and fill in your values
# NEVER commit the real .env file to version control
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production | test

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DB_SCHEMA=easleydunn
DB_CONNECTION_LIMIT=10

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in ms
RATE_LIMIT_MAX=100            # max requests per window per IP

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info                # error | warn | info | http | debug

# ── API ──────────────────────────────────────────────────────
GOOGLE_PLAY_DEVELOPERID="your-google-play-developer-id-here"
API_URL=http://localhost:5001

# ── Apple Store Connect ─────────────────────────────────────────
APPLE_KEY_ID="your-apple-key-id-here"
APPLE_ISSUER_ID="your-apple-issuer-uuid-here"

# -- Kanboard API --
KANBOARD_API_URL=https://your-kanboard-domain/jsonrpc.php
KANBOARD_API_USERNAME=jsonrpc
KANBOARD_API_TOKEN=your-kanboard-api-token
KANBOARD_DEFAULT_PROJECT_ID=1
KANBOARD_DEFAULT_ROLE=project-member

# -- Discord --
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_INVITE_CHANNEL_ID=the-channel-id-invites-are-created-against
DISCORD_GUILD_ID=fallback-guild-id-used-when-no-access-row-exists-yet

# -- Cerberus Admin Login (magic link) --

# ── Session ──────────────────────────────────────────────────────────────────
# Signs the session cookie. The app refuses to start without it.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

SESSION_COOKIE_NAME=sid
SESSION_IDLE_MINUTES=30        # sliding window; reset on each request
SESSION_ABSOLUTE_HOURS=8       # hard cap from login, regardless of activity
# "lax" is correct when the API and frontend are same-site (ports are ignored).
# Use "none" only for cross-site deployments — it also requires HTTPS.
SESSION_SAMESITE=lax

# ── Password hashing ─────────────────────────────────────────────────────────
# OPTIONAL. Falls back to the original hardcoded value if unset, so existing
# logins keep working either way.
# WARNING: setting this to anything else invalidates every stored password
# hash — nobody will be able to log in. Rotating it properly needs a
# hash_version column and a re-hash on next login. See to-do/October 8th.txt.
# PASSWORD_PEPPER=

# ── Mail (required by src/utils/mail.js) ─────────────────────────────────────
MAIL_SMTP_HOSTNAME=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-smtp-username
MAIL_SMTP_PASSWORD=your-smtp-password
MAIL_FROM=cerberus@example.com

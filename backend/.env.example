# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env.
#
# [REQUIRED] the app will not start, or a core flow will not work, without it
# [OPTIONAL] has a working default; the value shown IS the default
#
# Long explanations and the production checklist live in
# important/environment-variables.txt and important/before-prod-deploy.txt
# =============================================================================


# ── Secrets ──────────────────────────────────────────────────────────────────

# [REQUIRED] min 32 chars. Server throws at startup if missing or too short.
# Generate:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# [OPTIONAL locally, REQUIRED in production]
# Mixed into every password before hashing. Unset = a value hardcoded in the
# repo, which is public, which protects nothing.
# Generate:  openssl rand -base64 32
#
# WARNING: changing this invalidates EVERY stored password. Everyone is locked
# out, admin included. Only safe to set on a database with no accounts yet.
# PASSWORD_PEPPER=


# ── Database ─────────────────────────────────────────────────────────────────

# [REQUIRED] no default.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# [REQUIRED] was "easleydunn" before the refactor — same name, new value.
# Wrong value = app starts fine and every table looks empty.
DB_SCHEMA=refactor

# [OPTIONAL] max pooled connections
DB_CONNECTION_LIMIT=10

# [OPTIONAL] "false" turns TLS off entirely. Default is TLS WITHOUT checking
# the server's certificate — fine for Supabase, not for production.
# DB_SSL=false


# ── Server ───────────────────────────────────────────────────────────────────

# [OPTIONAL] local dev usually runs on 5001
PORT=5000

# [OPTIONAL] development | production | test
# Anything except "development" or "test" turns ON secure cookies, so a typo
# fails safe. Secure cookies need HTTPS or sign-in silently does nothing.
NODE_ENV=development

# [OPTIONAL] shown in the API docs and logs. Not used for invite links.
API_URL=http://localhost:5001

# [OPTIONAL] error | warn | info | http | debug
LOG_LEVEL=info


# ── CORS — this one does two jobs ────────────────────────────────────────────

# [REQUIRED in production] comma-separated list of allowed browser origins.
#
# THE FIRST ENTRY IS ALSO THE BASE URL FOR INVITE AND RESET LINKS IN EMAILS.
# Wrong order = emails send fine and every link points somewhere useless.
CORS_ORIGINS=http://localhost:3000


# ── Session ──────────────────────────────────────────────────────────────────

# [OPTIONAL]
SESSION_COOKIE_NAME=sid

# [OPTIONAL] sliding window, resets on each request
SESSION_IDLE_MINUTES=30

# [OPTIONAL] hard cap from sign-in, regardless of activity
SESSION_ABSOLUTE_HOURS=8

# [OPTIONAL] "lax" is right when API and frontend are same-site (ports ignored).
# "none" is only for cross-site, needs HTTPS, and makes CSRF tokens mandatory —
# which are NOT built. Keep same-site.
SESSION_SAMESITE=lax


# ── Rate limiting ────────────────────────────────────────────────────────────
# Two budgets, both per IP. Sign-in has its own so the console cannot spend it.

# [OPTIONAL] general API traffic
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# [OPTIONAL] sign-in attempts. Successful sign-ins do not count.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10


# ── Mail ─────────────────────────────────────────────────────────────────────
# [REQUIRED] invites are how every account gets its first password. No mail,
# no way in.
#
# Local: run `npm run maildev`, inbox at http://localhost:1080, nothing leaves
# the machine, any address works.

MAIL_SMTP_HOSTNAME=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=cerberus@easleydunn.local

# Production: a real SMTP service (SendGrid, Resend, SES, Gmail app password).
# MAIL_SMTP_HOSTNAME=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=your-smtp-username
# MAIL_SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=cerberus@example.com


# =============================================================================
# CONNECTORS — only needed for the services you actually use.
# A missing value does not stop the server. It fails when someone clicks grant.
# The .json key files are secrets and must never be committed.
# =============================================================================

# ── Google Drive ──  needs a service-account .json in backend/googledrive_json/
# Folder the service account shares with onboarded users (ID from its URL).
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ── Google Play ──  needs a .json in backend/googleplay_json/
GOOGLE_PLAY_DEVELOPERID="your-google-play-developer-id-here"

# ── Google Analytics ──  needs a .json in backend/googleanalytics_json/
# [OPTIONAL] account the new user is bound to, e.g. accounts/123456
# GOOGLE_ANALYTICS_PARENT_RESOURCE=accounts/000000

# ── Google Cloud ──  needs a .json in backend/googlecloud_json/
# No variables; the key file is all it reads.

# ── Apple Store Connect ──
APPLE_KEY_ID="your-apple-key-id-here"
APPLE_ISSUER_ID="your-apple-issuer-uuid-here"
# The .p8 private key as ONE line, with real newlines written as \n
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"

# ── Kanboard ──
KANBOARD_API_URL=https://your-kanboard-domain/jsonrpc.php
# [OPTIONAL] base URL for links. Derived from KANBOARD_API_URL if unset.
# KANBOARD_URL=https://your-kanboard-domain
KANBOARD_API_USERNAME=jsonrpc
KANBOARD_API_TOKEN=your-kanboard-api-token
KANBOARD_DEFAULT_PROJECT_ID=1
KANBOARD_DEFAULT_ROLE=project-member

# ── Discord ──  not configured today, so the connector cannot work
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_INVITE_CHANNEL_ID=the-channel-id-invites-are-created-against
DISCORD_GUILD_ID=fallback-guild-id-used-when-no-access-row-exists-yet
